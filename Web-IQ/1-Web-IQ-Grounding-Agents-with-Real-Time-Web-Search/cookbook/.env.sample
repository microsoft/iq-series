# Copy this file to .env and fill in your values:
#   cp .env.sample .env        (macOS/Linux)
#   Copy-Item .env.sample .env (Windows PowerShell)

# Web IQ API key — create one in the Web IQ Portal under Profile Management > Authentication:
# https://webiq.microsoft.ai/profiles/
WEBIQ_API_KEY=<your-web-iq-api-key>

# Web IQ API base URL (default shown; no need to change)
WEBIQ_BASE_URL=https://api.microsoft.ai/v3

# Optional — only used in Step 9 to generate a grounded answer with a Microsoft Foundry model.
# Leave blank to have Step 9 print the grounded prompt instead. Requires `az login`.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

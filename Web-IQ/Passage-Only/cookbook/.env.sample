# Copy this file to .env in this cookbook directory and set your Web IQ API key.
# Keep .env private; do not commit API keys or access tokens.
WEBIQ_API_KEY=<your-web-iq-api-key>

# Optional: defaults to the hosted Web IQ v3 API.
WEBIQ_BASE_URL=https://api.microsoft.ai/v3

# Optional: leave both blank to print the complete grounded prompt instead.
# With a Foundry endpoint, run az login and use a Responses-compatible deployment.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=
